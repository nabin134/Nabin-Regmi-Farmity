# Copy this file to .env and put your real app password on the EMAIL_HOST_PASSWORD line.
# IMPORTANT: .env must contain KEY=value only. Do NOT put Python code (e.g. os.environ.get(...)) here.
# Correct:   EMAIL_HOST_PASSWORD=your16charapppassword
# Wrong:    EMAIL_HOST_PASSWORD = os.environ.get('xxx')

EMAIL_HOST_PASSWORD=your-16-char-app-password

# Optional overrides (defaults are already set in settings.py):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=farmityforyou@gmail.com
# DEFAULT_FROM_EMAIL=farmityforyou@gmail.com
